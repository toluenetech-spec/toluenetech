{
  "name": "toluene-tech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:dev": "wrangler dev server/src/index.ts --port 8787 --config server/wrangler.toml",
    "api:deploy": "wrangler deploy server/src/index.ts --config server/wrangler.toml",
    "api:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "db:migrate": "DATABASE_URL=$(cat .dev.vars | grep DATABASE_URL | cut -d= -f2) drizzle-kit migrate --config server/drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.3",
    "firebase": "^12.7.0",
    "framer-motion": "^11.18.2",
    "hono": "4.13.13",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "4.147.0"
  }
}
