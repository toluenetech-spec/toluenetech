# Copy to .dev.vars (Wrangler will load these automatically for `npm run dev`).
# Real production values go in with `wrangler secret put NAME` — never commit.

# --- Required ---

# Neon serverless Postgres connection string.
# From: Neon console -> Project -> Connection string (pooled, SSL enabled).
DATABASE_URL=postgres://user:pass@ep-....neon.tech/neondb?sslmode=require

# Random 32+ char string used to sign admin + client session JWTs.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-plus-random-hex-chars

# Admin password for POST /auth/admin/login. (Legacy X-TT-Admin-Password header
# is also accepted for backward compatibility during transition.)
ADMIN_PASSWORD=choose-a-strong-password

# --- AI ---

# AI provider: 'dahl' (recommended) | openai | anthropic | gemini
# Assistant stays disabled (returns 503) until AI_PROVIDER + AI_API_KEY are set.
AI_PROVIDER=dahl
AI_API_KEY=dahl_sk_xxxxxxxxxxxxx

# Optional per-surface overrides (baseline before DB-staged config).
# AI_MODEL_PUBLIC=deepseek-ai/DeepSeek-V4-Flash-0731
# AI_MODEL_REASONING=MiniMaxAI/MiniMax-M2.7
# AI_MODEL_FALLBACK=zai-org/GLM-5.3-Flash

# --- Firebase (optional — required only if you want Firebase ID-token sign-in for admin/clients) ---
FIREBASE_PROJECT_ID=toluene-tech-ed451

# --- Misc ---

# DEV_MODE enables the demo client shortcut and the legacy hardcoded password
# fallback. MUST be unset/false in production.
DEV_MODE=true

# Comma-separated allowed origins for CORS (no trailing slash).
# In production, pin to the custom domain(s) — avoid wildcards.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Public URL prefix for R2 assets. Set up in Cloudflare -> R2 -> bucket ->
# Public access (custom domain or r2.dev public URL).
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Optional: S3-compatible R2 credentials for generating signed download URLs
# for private files. Get these from Cloudflare dashboard -> R2 -> Manage API tokens.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET_NAME=toluenetech-assets

ASSISTANT_SECRET=replace-me-with-random-string
