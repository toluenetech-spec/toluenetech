# Copy to .dev.vars (Wrangler will load these automatically for `npm run dev`).
# Real production values go in with `wrangler secret put NAME` — never commit.

# Neon serverless Postgres connection string.
# From: Neon console -> Project -> Connection string (pooled, SSL enabled).
DATABASE_URL=postgres://user:pass@ep-....neon.tech/neondb?sslmode=require

# AI provider config — assistant will stay disabled (returns 503) until all three are set.
AI_PROVIDER=openai            # openai | anthropic | gemini
AI_API_KEY=sk-xxxxxxxxxxxxx
AI_MODEL=gpt-4o-mini

# Random string (any 32+ chars) used for signing/rate-limit salt.
ASSISTANT_SECRET=replace-me-with-random-string

# Comma-separated allowed origins for CORS (no trailing slash).
CORS_ORIGIN=http://localhost:5173,https://curious-sprinkles-59674e.netlify.app,https://toluenetech.com

# Public URL prefix for R2 assets (set up in Cloudflare dashboard -> R2 -> bucket -> Public access -> custom domain).
R2_PUBLIC_URL=https://assets.toluenetech.com
